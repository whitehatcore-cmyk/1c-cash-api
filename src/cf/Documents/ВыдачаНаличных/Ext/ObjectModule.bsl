Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если Сумма <= 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Сумма выдачи должна быть больше нуля.";
		Сообщение.Сообщить();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Движения.ДенежныеСредстваВКассах.Записывать = Истина;
	
	Движение = Движения.ДенежныеСредстваВКассах.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	Движение.Период = Дата;
	Движение.Касса = Касса;
	Движение.Сумма = Сумма;
	Движения.ДенежныеСредстваВКассах.БлокироватьДляИзменения = Истина;
	
	Движения.Записать();
	
	ПроверитьОстатокКассы(Отказ);
	
КонецПроцедуры   

Функция РассчитатьДефицитКассы()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|   -Остатки.СуммаОстаток КАК Дефицит
	|ИЗ
	|   РегистрНакопления.ДенежныеСредстваВКассах.Остатки(
	|       &МоментВремени,
	|       Касса = &Касса) КАК Остатки
	|ГДЕ
	|   Остатки.СуммаОстаток < 0";
	
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(МоментВремени(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Касса", Касса);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Дефицит;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Процедура ПроверитьОстатокКассы(Отказ)
	
	Дефицит = РассчитатьДефицитКассы();
	
	Если Дефицит = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("РезультатКонтроля", Новый Структура("Код, Дефицит","НедостаточноСредств", Дефицит));
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст =
	"Недостаточно денежных средств в кассе. "
	+ "Не хватает " + Формат(Дефицит, "ЧДЦ=2") + " руб.";
	Сообщение.Сообщить();
	
	Отказ = Истина;
	
КонецПроцедуры
